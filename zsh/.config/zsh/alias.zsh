command -v eza > /dev/null && alias ls='eza -bh'
command -v bat > /dev/null && alias cat='bat --plain'

alias rm='rm -i'
alias la='ls -la'  lt='ls --tree'  ll='ls -l'  l='ls'
alias cp='cp -v'   mv='mv -v'

alias python='python3'
alias pip='pip3'

# cli
alias oc='opencode'
alias zq='ccs zq'
alias cc='claude'
alias cx='codex'
